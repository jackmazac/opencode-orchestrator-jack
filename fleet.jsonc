{
  // Local OpenCode plugin fleet manifest. This is the editable source for fleet checks.
  "schema_version": 1,
  "opencode_config": {
    "root": "~/.config/opencode",
    "config_file": "opencode.json"
  },
  "plugins": [
    {
      // host-adapter is a library/contract harness, not a runtime plugin.
      "name": "host-adapter",
      "package": "@mazac-fox/opencode-host-adapter",
      "source": { "kind": "file", "ref": "~/Developer/opencode-host-adapter" },
      "enabled": true,
      "check_command": "bun test",
      "telemetry": { "emits": ["plugin-boundary"] }
    },
    {
      "name": "conductor",
      "package": "@mazac-fox/opencode-conductor",
      "source": { "kind": "file", "ref": "~/Developer/opencode-conductor" },
      "plugin_ref": "file://~/Developer/opencode-conductor/src/index.ts",
      "cli_bin": "conductor",
      "enabled": true,
      "expected_tools": [
        "audit_write",
        "audit_read",
        "audit_done",
        "audit_progress_update",
        "audit_progress_read",
        "audit_progress_done",
        "handoff_write",
        "handoff_read",
        "handoff_done",
        "journal_write",
        "journal_read",
        "journal_done",
        "progress_update",
        "progress_read",
        "progress_done",
        "run_init",
        "run_update",
        "run_finish",
        "status_write",
        "status_read",
        "status_done",
        "persist_subplan",
        "read_subplan",
        "discard_subplan",
        "persist_final_plan",
        "read_final_plan",
        "discard_final_plan",
        "persist_brainstorm",
        "read_brainstorm",
        "discard_brainstorm",
        "persist_design",
        "read_design",
        "discard_design",
        "conflict_context",
        "context_usage",
        "lifecycle_concord_ingest",
        "explore_fast",
        "discard_explore_cache",
        "commit",
        "artifact_index",
        "run_list",
        "session_init",
        "drift_check",
        "plan_validate",
        "journal_search",
        "workspace_info",
        "task_dispatch",
        "spine_query",
        "changelog_emit"
      ],
      "doctor_command": "bun run check",
      "telemetry": { "emits": ["profile", "policy", "lifecycle"] }
    },
    {
      "name": "engram",
      "package": "opencode-engram",
      "source": { "kind": "file", "ref": "~/Developer/engram" },
      "plugin_ref": "file://~/Developer/engram/src/index.ts",
      "cli_bin": "engram",
      "enabled": true,
      "expected_tools": [
        "memory",
        "memory_context",
        "memory_feedback",
        "forget",
        "stats",
        "conflict_context",
        "lifecycle_ingest"
      ],
      "doctor_command": "bun run check",
      "telemetry": { "sink": true, "emits": ["memory", "artifact", "retrieval"] }
    },
    {
      "name": "concord",
      "package": "@concord/plugin",
      "source": { "kind": "file", "ref": "~/Developer/concord" },
      "plugin_ref": "file://~/Developer/concord/packages/concord-plugin/src/index.ts",
      "cli_bin": "concord",
      "enabled": true,
      "mode": "hook",
      "expected_hooks": [
        "chat.message",
        "event",
        "experimental.session.compacting",
        "tool.execute.before",
        "tool.execute.after"
      ],
      "expected_hooks_exact": true,
      "check_command": "bun run check",
      "check_timeout_ms": 300000,
      "telemetry": { "emits": ["collision", "guidance", "health"] }
    },
    {
      "name": "codemem",
      "package": "@mazac-fox/codemem-plugin",
      "source": { "kind": "file", "ref": "~/Developer/codemem" },
      "plugin_ref": "file://~/Developer/codemem/packages/codemem-plugin/src/index.ts",
      "cli_bin": "codemem",
      "enabled": true,
      "mode": "plugin",
      "expected_tools": [
        "codemem_check",
        "codemem_drift_map",
        "codemem_conflicts",
        "codemem_change_risk",
        "codemem_before_edit",
        "codemem_review_focus",
        "codemem_api_surface",
        "codemem_impact_cone",
        "codemem_layer_boundaries",
        "codemem_artifact"
      ],
      "check_command": "bun run verify",
      "check_timeout_ms": 300000,
      "telemetry": { "emits": ["graph", "review", "health"] }
    }
  ],
  "external_plugins": [
    // DCP owns context pruning through dcp.jsonc and prompt overrides.
    "@tarquinen/opencode-dcp@latest"
  ]
}
