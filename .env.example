# Copy to `.env` and fill in only local secrets. `.env` and `.env.*` are gitignored;
# this example file is tracked and must never contain real credentials.
# OpenCode resolves `{env:NAME}` in `opencode.json`.

# OpenAI models. You may also export this in your shell instead of using `.env`.
OPENAI_API_KEY=

# Amazon Bedrock / AWS. Prefer normal AWS config or SSO when possible; explicit
# environment credentials are optional and should remain local-only.
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Motif MCP (`mcp.motif` in opencode.json)
# Exa/Motif secrets may also be stored in macOS Keychain and inspected with:
#   security find-generic-password -s <service> -w
E2E_AUTH_SECRET=
